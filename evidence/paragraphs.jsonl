{"char_offset": [6119, 6153], "fetched_at": "2026-11-20T12:48:24Z", "heading_path": ["Influenza (seasonal)", "Treatment"], "language": "en", "page_nature": "live", "paragraph_index": 35, "paragraph_text": "treat other symptoms such as fever", "published_or_updated": "", "selector": "Influenza (seasonal) > Treatment > p[35]", "sha256_of_page": "4ccdfce9f34438558f46c2d3fd53c441529a154dd83b98f3ba46a71d756631af", "sha256_of_paragraph": "56a0738194f36735e86c3595b5cf596041881a81c3918aa520943dbe007f8de6", "source_id": "WHO-FLU", "tag": "p", "url": "https://www.who.int/news-room/fact-sheets/detail/influenza-(seasonal)"}
{"char_offset": [6154, 6194], "fetched_at": "2026-11-20T12:48:24Z", "heading_path": ["Influenza (seasonal)", "Treatment"], "language": "en", "page_nature": "live", "paragraph_index": 36, "paragraph_text": "seek medical care if symptoms get worse.", "published_or_updated": "", "selector": "Influenza (seasonal) > Treatment > p[36]", "sha256_of_page": "4ccdfce9f34438558f46c2d3fd53c441529a154dd83b98f3ba46a71d756631af", "sha256_of_paragraph": "176bc1c17ed44106bfc2d0cf39d0905c245dba0c2569fccd93249d2d3500335f", "source_id": "WHO-FLU", "tag": "p", "url": "https://www.who.int/news-room/fact-sheets/detail/influenza-(seasonal)"}
{"char_offset": [6195, 6333], "fetched_at": "2026-11-20T12:48:24Z", "heading_path": ["Influenza (seasonal)", "Treatment"], "language": "en", "page_nature": "live", "paragraph_index": 37, "paragraph_text": "People at high risk or with severe symptoms should be treated with antiviral medications as soon as possible. They include people who are:", "published_or_updated": "", "selector": "Influenza (seasonal) > Treatment > p[37]", "sha256_of_page": "4ccdfce9f34438558f46c2d3fd53c441529a154dd83b98f3ba46a71d756631af", "sha256_of_paragraph": "57de9e0738979bb6b6d69032569cf3b1f533a1e2a34bca7301f398fbc1480def", "source_id": "WHO-FLU", "tag": "p", "url": "https://www.who.int/news-room/fact-sheets/detail/influenza-(seasonal)"}
