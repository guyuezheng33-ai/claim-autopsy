{"char_offset": [7392, 7428], "fetched_at": "2026-11-20T12:48:24Z", "heading_path": ["Influenza (seasonal)", "Prevention"], "language": "en", "page_nature": "live", "paragraph_index": 52, "paragraph_text": "avoid close contact with sick people", "published_or_updated": "", "selector": "Influenza (seasonal) > Prevention > p[52]", "sha256_of_page": "4ccdfce9f34438558f46c2d3fd53c441529a154dd83b98f3ba46a71d756631af", "sha256_of_paragraph": "07523092340b6db76d155151938f8a48d49c586b42342a21eb0b106ee3ee0c7b", "source_id": "WHO-FLU", "tag": "p", "url": "https://www.who.int/news-room/fact-sheets/detail/influenza-(seasonal)"}
