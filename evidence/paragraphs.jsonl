{"char_offset": [8098, 8239], "fetched_at": "2026-11-20T12:48:50Z", "heading_path": ["About Vaccines for your Children", "Childhood Vaccines"], "language": "en-us", "page_nature": "live", "paragraph_index": 31, "paragraph_text": "Vaccines can help protect babies and children from serious, even deadly, diseases. It’s important to stay up to date on recommended vaccines.", "published_or_updated": "", "selector": "About Vaccines for your Children > Childhood Vaccines > p[31]", "sha256_of_page": "899a3460de9c431c8407bd56812a20665786d7f147fa61e50372976e3928bb9e", "sha256_of_paragraph": "d6e93ee0459c8784088fd37a43aa5020712c9c688eb2a0bc5d30757380a7dd41", "source_id": "CDC-VAC", "tag": "p", "url": "https://www.cdc.gov/vaccines-children/about/"}
